# Copiá este archivo a .env y completá con tus datos reales.
# .env NUNCA se sube a git — y a diferencia del .env del frontend,
# ACÁ SÍ van las claves secretas (R2 secret, etc). Este proceso corre
# en un servidor propio, nunca en el navegador.

# --- Supabase (mismo proyecto que usa el frontend) ---
# Se usa SOLO la anon key — nunca la service_role key. Cada request
# corre autenticado con el token del usuario que llama (ver app/deps.py).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica

# --- Cloudflare R2 ---
R2_ENDPOINT_URL=https://TU-ACCOUNT-ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=tu-access-key-id
R2_SECRET_ACCESS_KEY=tu-secret-access-key
R2_BUCKET_NAME=clubpack

# --- CORS: orígenes del frontend permitidos (separados por coma) ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Opcionales ---
STAGING_TTL_SEG=1800
MAX_UPLOAD_MB=200

# --- Mercado Pago (suscripción mensual) ---
# Opcionales: sin esto, el grupo puede seguir usando solo transferencia
# manual (ver Admin > Suscripción en el frontend). Para activar el pago
# automático completá estas tres:
#
# MP_ACCESS_TOKEN: "Tus integraciones" > tu app > Credenciales de
#   producción (o de prueba mientras testeás) > Access Token.
# MP_WEBHOOK_SECRET: "Tus integraciones" > tu app > Webhooks >
#   Configurar notificaciones > "Clave secreta". La URL a configurar ahí
#   es la de ESTE backend + /suscripcion/mercadopago/webhook (tiene que
#   ser pública, no http://localhost — en local hace falta algo como
#   ngrok/cloudflared para probar webhooks de verdad).
# BACKEND_INTERNAL_SECRET: generado por vos (`openssl rand -hex 32`), NO
#   es de Mercado Pago. Tiene que coincidir con el hash que insertaste en
#   la tabla secretos_internos (ver sql/003_pagos.sql).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
BACKEND_INTERNAL_SECRET=

# URL pública del frontend, para volver ahí después de pagar en Mercado Pago.
FRONTEND_URL=http://localhost:5173

# --- Telegram: alerta instantánea de nuevo registro ---
# Opcionales: sin esto, el registro sigue funcionando pero no avisa nada.
#
# TELEGRAM_BOT_TOKEN: hablale a @BotFather en Telegram, mandale /newbot
#   y seguí los pasos — te da el token.
# TELEGRAM_CHAT_ID: hablale a @userinfobot en Telegram — te devuelve tu
#   Chat ID (el tuyo, para que el aviso te llegue a vos).
# REGISTRO_WEBHOOK_SECRET: generalo vos (`openssl rand -hex 32`). Se
#   configura también en Supabase > Database > Webhooks, como un header
#   "X-Webhook-Secret" en el webhook que llama a
#   <este backend>/webhooks/nuevo-registro en cada INSERT a perfiles.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REGISTRO_WEBHOOK_SECRET=

# Tamaño máximo de imagen (portada de track, imagen de herramienta DJ).
MAX_IMAGEN_MB=8
